# Funton AI Manufacturing ERP - Backend Environment
# Copy to .env and fill values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/futon_manufacturing.db
# For production-like file location from project root perspective (backend runs with cwd=backend)

# Application
APP_NAME=Funton AI Manufacturing ERP
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (comma separated for frontend later)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security / JWT (Phase 3+)
# SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Configuration (Required for the AI Supervisor chat)
# The AI Supervisor uses a real LLM. We recommend xAI (Grok) as the primary option.

# === Recommended: xAI (Grok) ===
XAI_API_KEY=xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEFAULT_LLM_PROVIDER=xai
XAI_MODEL=grok-3

# === Alternatives ===
# GROQ_API_KEY=gsk_...                    # Fast & generous free tier
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_LLM_PROVIDER=groq
