# ==========================================
# Funton AI - Comprehensive .gitignore
# ==========================================

# ------------------
# Python / Backend
# ------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# Environment Variables (SENSITIVE - API keys, secrets, DB credentials)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# Database files (can contain sensitive or large sample data)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
backend/data/*.db
backend/data/*.sqlite

# Logs
logs/
*.log
backend/logs/
*.log

# ------------------
# Node.js / Frontend (Vite + React)
# ------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ------------------
# IDE / Editor
# ------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------
# OS Generated
# ------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------
# Testing & Coverage
# ------------------
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/
.cache/
.ruff_cache/

# ------------------
# Misc
# ------------------
*.bak
*.tmp
*.temp
*.old

# Keep the SQL seed file (source of truth), but ignore compiled DBs
!data/futon_manufacturing_sqlite.sql
!backend/data/futon_manufacturing_sqlite.sql
backend/data/futon_manufacturing.db-shm
backend/data/futon_manufacturing.db-wal
data/*.db-shm
data/*.db-wal
